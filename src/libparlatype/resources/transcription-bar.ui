<?xml version="1.0" encoding="UTF-8"?>
<interface domain="libadwaita">
  <requires lib="gtk" version="4.0" />
  <template class="PtTranscriptionBar" parent="GtkWidget">
    <!--<accessibility>
      <relation name="labelled-by">title</relation>
    </accessibility>-->
    <child>
      <object class="GtkRevealer" id="revealer">
        <property name="transition-type">slide-down</property>
        <property name="child">
          <object class="GtkBox" id="box">
            <property name="hexpand">True</property>
            <property name="spacing">12</property>
            <child>
              <object class="GtkDropDown" id="model_selector"/>
            </child>
            <child>
              <object class="AdwSplitButton" id="transcribe_button">
                <property name="icon-name">play-symbolic</property>
                <property name="action-name">win.transcribe</property>
                <child>
                  <object class="GtkPopover">
                    <child>
                      <object class="GtkListBox" id="options_box">
                        <style>
                          <class name="navigation-sidebar"/>
                        </style>
                        <child type="placeholder">
                          <object class="GtkLabel">
                            <property name="label">No options available</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton">
                <property name="icon-name">chat-message-new-symbolic</property>
                <property name="action-name">win.show-model-dialog</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="close_button">
                <property name="icon-name">window-close-symbolic</property>
                <property name="valign">center</property>
                <property name="hexpand">True</property>
                <property name="halign">end</property>
                <property name="visible">True</property>
                <signal name="clicked" handler="close_button_clicked" swapped="yes" />
                <style>
                  <class name="close"/>
                </style>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
