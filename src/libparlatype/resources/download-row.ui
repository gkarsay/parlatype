<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="PtDownloadRow" parent="AdwPreferencesRow">
    <style>
      <class name="expander"/>
    </style>
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkListBox">
            <property name="accessible-role">generic</property>
            <property name="selection-mode">none</property>
            <child>
              <object class="AdwActionRow" id="download_row">
                <style>
                  <class name="header"/>
                </style>
                <property name="title" translatable="yes">Download Model</property>
                <child type="suffix">
                  <object class="GtkButton" id="download_button">
                    <signal name="clicked" handler="download_button_clicked_cb" swapped="yes" />
                    <property name="label">Download</property>
                    <property name="sensitive">true</property>
                    <property name="valign">3</property>
                    <property name="halign">3</property>
                    <style>
                      <class name="suggested-action"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkRevealer" id="revealer">
            <property name="hexpand">true</property>
            <property name="child">
              <object class="GtkListBox">
                <style>
                  <class name="nested"/>
                </style>
                <child>
                  <object class="AdwPreferencesRow">
                    <property name="child">
                      <!--<object class="GtkBox">
                        <child>-->
                          <object class="GtkGrid" id="grid">
                            <child>
                              <object class="GtkLabel" id="progress_label">
                                <property name="label">Download amount</property>
                                <property name="halign">1</property>
                                <style>
                                  <class name="dimmed"/>
                                </style>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkProgressBar" id="progress_bar">
                                <property name="fraction">0.0</property>
                                <property name="hexpand">true</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="rate_label">
                                <property name="label">Download speed</property>
                                <property name="halign">1</property>
                                <style>
                                  <class name="dimmed"/>
                                </style>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="cancel_button">
                                <signal name="clicked" handler="cancel_button_clicked_cb" swapped="yes" />
                                <property name="icon-name">window-close-symbolic</property>
                                <property name="valign">3</property>
                                <style>
                                  <class name="circular"/>
                                </style>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">0</property>
                                  <property name="row-span">3</property>
                                </layout>
                              </object>
                            </child>
                          </object>
                        <!--</child>
                      </object>-->
                    </property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
