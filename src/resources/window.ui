<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="parlatype" version="0.0"/>
  <template class="PtWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">Parlatype</property>
    <property name="default_height">200</property>
  <child>
    <object class="AdwBreakpoint">
      <condition>max-width: 400sp</condition>
      <setter object="audio_split_view" property="collapsed">True</setter>
      <setter object="text_split_view" property="collapsed">True</setter>
    </object>
  </child>
    <property name="content">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="GtkHeaderBar" id="headerbar">
            <property name="show-title-buttons">1</property>
            <child type="start">
              <object class="GtkToggleButton" id="show_sidebar_button">
                <property name="icon-name">view-sidebar-start-symbolic</property>
                <property name="tooltip-text" translatable="yes">Toggle Sidebar</property>
                <property name="active">True</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkMenuButton" id="primary_menu_button">
                <property name="menu-model">primary_menu</property>
                <property name="tooltip-text" translatable="yes">Main Menu</property>
                <property name="primary">True</property>
                <property name="direction">none</property>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="GtkPaned" id="paned">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkBox"> <!-- paned top child -->
                <property name="css-name">main_box</property>
                <property name="orientation">horizontal</property>
                <property name="spacing">6</property>
                <child>
                  <object class="AdwOverlaySplitView" id="audio_split_view">
                    <property name="show-sidebar" bind-source="show_sidebar_button" bind-property="active" bind-flags="sync-create|bidirectional"/>
                    <property name="sidebar">
                      <object class="GtkBox">
                        <property name="css-name">audio_controls</property>
                        <property name="orientation">vertical</property>
                        <property name="halign">center</property>
                        <property name="hexpand_set">1</property>
                        <property name="valign">end</property>
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkBox"> <!-- playback rate and volume buttons -->
                            <property name="halign">center</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="PtPlaybackRateButton" id="playback_rate_button">
                              </object>
                            </child>
                            <child>
                              <object class="PtVolumeButton" id="volume_button">
                              </object>
                            </child>
                          </object>
                        </child> <!-- playback rate and volume buttons -->
                        <child>
                          <object class="GtkMenuButton" id="pos_menu_button">
                            <property name="menu-model">secondary_menu</property>
                            <property name="halign">center</property>
                            <property name="hexpand">1</property>
                            <property name="hexpand-set">1</property>
                            <property name="can_focus">1</property>
                            <property name="receives_default">1</property>
                            <property name="direction">up</property>
                            <style>
                              <class name="timebutton" />
                            </style>
                          </object>
                        </child> <!-- time button -->
                        <child>
                          <object class="GtkBox" id="controls_box">
                            <property name="halign">center</property>
                            <property name="valign">baseline-center</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkButton" id="button_jump_back">
                                <property name="sensitive">0</property>
                                <property name="can_focus">1</property>
                                <property name="receives_default">1</property>
                                <property name="halign">start</property>
                                <property name="action_name">win.jump-back</property>
                                <property name="icon_name">media-skip-backward-symbolic</property>
                                <accessibility>
                                  <property name="label" translatable="yes">Skip backward</property>
                                </accessibility>
                                <style><class name="circular"/></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkToggleButton" id="button_play">
                                <property name="can_focus">1</property>
                                <property name="receives_default">1</property>
                                <signal name="toggled" handler="play_button_toggled_cb" swapped="no"/>
                                <property name="icon_name">media-playback-start-symbolic</property>
                                <accessibility>
                                  <property name="label" translatable="yes">Play</property>
                                </accessibility>
                                <style><class name="circular"/></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="button_jump_forward">
                                <property name="sensitive">0</property>
                                <property name="can_focus">1</property>
                                <property name="receives_default">1</property>
                                <property name="halign">start</property>
                                <property name="action_name">win.jump-forward</property>
                                <property name="icon_name">media-skip-forward-symbolic</property>
                                <accessibility>
                                  <property name="label" translatable="yes">Skip forward</property>
                                </accessibility>
                                <style><class name="circular"/></style>
                              </object>
                            </child>
                          </object>
                        </child> <!-- controls box -->
                      </object> <!-- audio_controls -->
                    </property> <!-- sidebar -->
                    <property name="content">
                      <object class="GtkStack" id="waveviewer_stack">
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">empty</property>
                            <property name="child">
                              <object class="AdwStatusPage">
                                <property name="title">Audio File</property>
                                <property name="description">Drag in or open an audio file.</property>
                                  <child>
                                    <object class="GtkButton">
                                      <property name="label" translatable="yes">_Open</property>
                                      <property name="halign">center</property>
                                      <property name="can_focus">1</property>
                                      <property name="receives_default">1</property>
                                      <property name="tooltip_text" translatable="yes">Open a file</property>
                                      <property name="action_name">app.open</property>
                                      <property name="use_underline">1</property>
                                      <style>
                                        <class name="suggested-action"/>
                                        <class name="pill"/>
                                      </style>
                                    </object>
                                  </child>
                              </object>  <!-- status page -->
                            </property>
                          </object> <!-- stack page empty -->
                        </child>
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">waveviewer</property>
                            <property name="child">
                              <object class="GtkOverlay">
                                <child>
                                  <object class="PtWaveviewer" id="waveviewer">
                                    <property name="css-name">waveviewer</property>
                                    <property name="can_focus">True</property>
                                    <property name="hexpand">True</property>
                                    <property name="vexpand">True</property>
                                  </object>
                                </child>
                                <child type="overlay">
                                  <object class="GtkProgressBar" id="progress">
                                    <property name="valign">end</property>
                                    <property name="accessible-role">presentation</property>
                                  </object>
                                </child>
                              </object> <!-- waveviewer_overlay -->
                            </property>
                          </object> <!-- stack page -->
                        </child>
                      </object> <!-- stack -->
                    </property> <!-- split view content -->
                  </object> <!-- split view -->
                </child>
              </object>
            </child> <!-- paned top child    -->
            <child>  <!-- paned bottom child -->
              <object class="AdwOverlaySplitView" id="text_split_view">
                <property name="show-sidebar" bind-source="show_sidebar_button" bind-property="active" bind-flags="sync-create|bidirectional"/>
                <property name="sidebar">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <property name="halign">center</property>
                    <property name="margin-top">12</property>
                    <child>
                      <object class="GtkButton">
                        <property name="label">Serialize</property>
                        <property name="action_name">win.serialize</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton">
                        <property name="label">Deserialize</property>
                        <property name="action_name">win.deserialize</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSwitch" id="timestamp_switch">
                        <property name="halign">center</property>
                      </object>
                    </child>
                  </object>
                </property>
                <property name="content">
                  <object class="GtkScrolledWindow">
                    <child>
                      <object class="PtTextView" id="text_view">
                        <property name="can_focus">True</property>
                        <property name="vexpand">True</property>
                        <property name="halign">start</property>
                        <property name="width-request">400</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child> <!-- child of paned -->
          </object> <!-- paned -->
        </property>  <!-- content -->
      </object>  <!-- AdwToolbar -->
    </property> <!-- content -->
  </template>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="custom">theme</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_Open</attribute>
        <attribute name="action">app.open</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Preferences</attribute>
        <attribute name="action">app.prefs</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">win.show-help-overlay</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Help</attribute>
        <attribute name="action">app.help</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">About Parlatype</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
  <menu id="secondary_menu">
      <item>
        <attribute name="label" translatable="yes">Copy Time to Clipboard</attribute>
        <attribute name="action">win.copy-timestamp-to-clipboard</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Go to Cursor</attribute>
        <attribute name="action">win.goto-cursor</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Go to…</attribute>
        <attribute name="action">win.goto</attribute>
      </item>
  </menu>
</interface>
