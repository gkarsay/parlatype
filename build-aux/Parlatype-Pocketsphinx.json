{
    "app-id" : "xyz.parlatype.Parlatype",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "51",
    "sdk" : "org.gnome.Sdk",
    "command" : "parlatype",
    "finish-args" : [
        "--device=dri",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio"
        "--share=network"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/share/man"
    ],
    "modules" : [
        {
            "name" : "pocketsphinx",
            "buildsystem" : "cmake",
            "config-opts" : [
                "-DBUILD_SHARED_LIBS=yes"
            ],
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://github.com/cmusphinx/pocketsphinx/archive/refs/tags/v5.0.4.tar.gz",
                    "sha256" : "9acd63cfdc76bbc85b7b6c6610b7a9cf30c79d5b36a31de7dc2f969e962653d7"
                }
            ],
            "cleanup" : [
                "/bin/pocketsphinx_*",
                "/lib/debug/bin/pocketsphinx_*"
            ]
        },
        {
            "name" : "libpeas",
            "buildsystem" : "meson",
            "config-opts" : [
                "-Dlua51=false",
                "-Dpython3=false"
            ],
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://gitlab.gnome.org/GNOME/libpeas/-/archive/2.2.1/libpeas-2.2.1.tar.gz",
                    "sha256" : "b15f94e165013870f2da2ebb8e77448d8c6b4c8075b74078280e12fbba961f9d"
                }
            ]
        },
        {
            "name" : "parlatype",
            "buildsystem" : "meson",
            "config-opts" : [
                "-Dplugin_pocketsphinx=true"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "branch" : "main",
                    "path" : "../"
                },
                {
                    "type" : "file",
                    "path" : "data/asr/en.sphinx.pocketsphinx5.asr",
                    "dest" : "data/asr"
                }
            ]
        }
    ]
}
