{
    "app-id" : "xyz.parlatype.Parlatype",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "51",
    "sdk" : "org.gnome.Sdk",
    "command" : "parlatype",
    "finish-args" : [
        "--device=dri",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--filesystem=home:ro"
    ],
    "cleanup" : [
        "*.la",
        "*.a",
        "/include",
        "/lib/pkgconfig",
        "/libexec",
        "/share/man"
    ],
    "modules" : [
        {
            "name": "python3-pycurl",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"pycurl\" --no-build-isolation"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/a6/b3/93b9b8b4ed45f4700b3f9fc40b5daf189e0badd71d0839a6ad09cefa2245/pycurl-7.49.0.tar.gz",
                    "sha256": "d4327da9dea72768f942f831bbaa5a64adca4d7c89f3141da7a833d3c600ab90"
                }
            ]
        },
        {
            "name" : "whisper.cpp",
            "buildsystem" : "cmake",
            "config-opts" : [],
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://github.com/ggml-org/whisper.cpp/archive/refs/tags/v1.8.4.tar.gz",
                    "sha256" : "b26f30e52c095ccb75da40b168437736605eb280de57381887bf9e2b65f31e66"
                }
            ],
            "cleanup" : []
        },
        {
            "name" : "libpeas",
            "buildsystem" : "meson",
            "config-opts" : [
                "-Dlua51=false",
                "-Dpython3=true"
            ],
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://gitlab.gnome.org/GNOME/libpeas/-/archive/2.2.1/libpeas-2.2.1.tar.gz",
                    "sha256" : "b15f94e165013870f2da2ebb8e77448d8c6b4c8075b74078280e12fbba961f9d"
                }
            ]
        },
        {
            "name" : "parlatype",
            "buildsystem" : "meson",
            "config-opts" : [
                "-Dgir=true",
                "-Dplugin_whisper=true",
                "-Dplugin_whisper_downloader=true"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "branch" : "pt5",
                    "path" : "../"
                }
            ]
        }
    ],
    "build-options" : {
        "env" : {        }
    }
}
