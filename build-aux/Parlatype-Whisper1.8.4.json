{
    "app-id" : "xyz.parlatype.Parlatype",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "command" : "parlatype",
    "finish-args" : [
        "--device=dri",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--filesystem=home:ro"
    ],
    "cleanup" : [
        "*.la",
        "*.a",
        "/include",
        "/lib/pkgconfig",
        "/libexec",
        "/share/man"
    ],
    "modules" : [
        {
            "name" : "whisper.cpp",
            "buildsystem" : "cmake",
            "config-opts" : [],
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://github.com/ggml-org/whisper.cpp/archive/refs/tags/v1.8.4.tar.gz",
                    "sha256" : "b26f30e52c095ccb75da40b168437736605eb280de57381887bf9e2b65f31e66"
                }
            ],
            "cleanup" : []
        },
        {
            "name" : "libpeas",
            "buildsystem" : "meson",
            "config-opts" : [
                "-Dlua51=false",
                "-Dpython3=true"
            ],
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://gitlab.gnome.org/GNOME/libpeas/-/archive/2.2.1/libpeas-2.2.1.tar.gz",
                    "sha256" : "b15f94e165013870f2da2ebb8e77448d8c6b4c8075b74078280e12fbba961f9d"
                }
            ]
        },
        {
            "name" : "parlatype",
            "buildsystem" : "meson",
            "config-opts" : [
                "-Dplugin_whisper=true",
                "-Dplugin_whisper_downloader=true"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "branch" : "dev/libpeas",
                    "path" : "../"
                }
            ]
        }
    ],
    "build-options" : {
        "env" : {        }
    }
}
