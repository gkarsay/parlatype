[library]
version = "@version@"
browse_url = "https://github.com/gkarsay/parlatype"
website_url = "https://www.parlatype.xyz"
authors = "Gabor Karsay"
logo_url = "parlatype.svg"
license = "GPL-3.0-or-later"
description = "Parlatype is an audio player and text editor for transcription"
dependencies = [ "GObject-2.0", "GLib-2.0" ]
devhelp = true
search_index = true

  [dependencies."GObject-2.0"]
  name = "GObject"
  description = "The base type system library"
  docs_url = "https://docs.gtk.org/gobject/"

  [dependencies."GLib-2.0"]
  name = "GLib"
  description = "The base type system library"
  docs_url = "https://docs.gtk.org/glib/"

[theme]
name = "basic"
show_index_summary = true
show_class_hierarchy = true

[extra]
content_files = [
  "timestamps.md",
  "file-format.md",
  "asr-plugins.md",
]

content_images = [
  "../../data/icons/scalable/parlatype.svg"
]
urlmap_file = "urlmap.js"